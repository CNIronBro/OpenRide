# Docker Compose 环境变量配置
# 复制此文件为 .env 后按需修改

# MySQL 配置
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3309

# Redis 配置
REDIS_PORT=6379

# RabbitMQ 配置
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# xxl-job 配置
XXL_JOB_PORT=8090
XXL_JOB_ACCESS_TOKEN=default_token